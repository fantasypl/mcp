# On-demand external reference checkout used for local development and
# parity verification; 115 MB and not ours to vendor.
/reference/

# Build output
/bin/
/dist/

# Runtime state: snapshots, backtest cache, tuned weights — schema-stable
# on-disk artifacts written and read by fplctl. GW snapshots are
# irreplaceable once a gameweek has been played, so back these up rather
# than relying on git.
/data/

# Local caches for Part B data sources (FPL-Core-Insights CSVs, ClubElo,
# vaastav corpus). Fetched on demand.
/.cache/

.DS_Store

# JetBrains IDE project files
/.idea/
